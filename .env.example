# Xendit (for Thailand BAY/Krungsri etc - Business ID from Dashboard → Settings → Business)
# XENDIT_DESTINATION_ACCOUNT_ID=your-business-id
# XENDIT_COMPONENTS_CURRENCY=IDR
# XENDIT_COMPONENTS_COUNTRY=ID
# Comma-separated extra HTTPS origins for Xendit Components.
# XENDIT_ALLOWED_ORIGINS=https://example.ngrok-free.app

# Canonical public base URL for payment redirects and origin allowlists.
# PUBLIC_BASE_URL=https://new-adyen-demo-377583b87f3c.herokuapp.com

# Required to delete all files from the temporary image host.
# Send as Bearer token or X-Image-Host-Delete-Token.
# IMAGE_HOST_DELETE_TOKEN=change-me

# Optional
# SECRET_KEY=your-secret-key
# FLASK_DEBUG=1
