# Adyen (test credentials from Customer Area)
# Merchant account: exact name from Adyen → Account → Merchant accounts (case-sensitive)
ADYEN_API_KEY=your-adyen-api-key
ADYEN_CLIENT_KEY=your-adyen-client-key
ADYEN_MERCHANT_ACCOUNT=your-adyen-merchant-account
ADYEN_ENVIRONMENT=test
ADYEN_MANAGEMENT_WRITE_TOKEN=change-me-management-write-token
HMAC_SECRET=your-adyen-webhook-hmac-secret

# Xendit (for Thailand BAY/Krungsri etc - Business ID from Dashboard → Settings → Business)
# XENDIT_DESTINATION_ACCOUNT_ID=your-business-id
XENDIT_SECRET_KEY=your-xendit-secret-key
XENDIT_PUBLIC_KEY=your-xendit-public-key

# Image host admin operations
IMAGE_HOST_DELETE_TOKEN=change-me-image-delete-token

# Optional
# SECRET_KEY=your-secret-key
# FLASK_DEBUG=1
