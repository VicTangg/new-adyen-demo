# Adyen (test credentials from Customer Area)
# Merchant account: exact name from Adyen → Account → Merchant accounts (case-sensitive)
ADYEN_API_KEY=your_adyen_api_key
ADYEN_CLIENT_KEY=your_adyen_client_key
ADYEN_MERCHANT_ACCOUNT=your_adyen_merchant_account
ADYEN_ENVIRONMENT=test
ADYEN_MANAGEMENT_WRITE_TOKEN=choose_a_strong_management_write_token

# Xendit (for Thailand BAY/Krungsri etc - Business ID from Dashboard → Settings → Business)
XENDIT_SESSION_AMOUNT=9498
XENDIT_SESSION_CURRENCY=IDR
XENDIT_SESSION_COUNTRY=ID
XENDIT_ALLOWED_ORIGINS=https://your-domain.example
# XENDIT_DESTINATION_ACCOUNT_ID=your-business-id

# Optional
# SECRET_KEY=your-secret-key
# FLASK_DEBUG=1
IMAGE_HOST_DELETE_TOKEN=choose_a_strong_image_delete_token
